{
  "name": "controllerdesktop",
  "version": "1.1.0",
  "description": "ControllerDesktop - Gamepad-Steuerung für Windows, portabel oder als Installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "node create-icons.js",
    "prebuild": "node create-icons.js",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "publish": "electron-builder --win --publish always"
  },
  "author": "ControllerDesktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.8.11"
  }
}
